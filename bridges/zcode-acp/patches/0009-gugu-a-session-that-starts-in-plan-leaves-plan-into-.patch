+
+/**
+ * gugu 0009: approving a plan returns the session to the mode underneath plan.
+ * A session that starts in plan never chose one; it must not leave plan into
+ * the bridge default (yolo), but into build (ask before edits and commands).
+ */
+describe("a session that starts in plan leaves plan into build", () => {
+  it("set_config_option(plan) before the first prompt puts build underneath", async () => {
+    const { server, backend, cx } = setup();
+    await setConfigOptionHandler(server, { sessionId: "sess_acp", configId: "mode", value: "plan" }, cx);
+    expect(backend.modeCalls).toEqual(["build", "plan"]);
+    expect(backend.modeNow).toBe("build");
+  });
+
+  it("session/set_mode(plan) before the first prompt does the same", async () => {
+    const { server, backend, cx } = setup();
+    await setMode(server, { sessionId: "sess_acp", modeId: "plan" }, cx);
+    expect(backend.modeCalls).toEqual(["build", "plan"]);
+    expect(backend.modeNow).toBe("build");
+  });
+
+  it("a switch to plan mid-session keeps the mode the user was in", async () => {
+    const { server, backend, cx } = setup();
+    server.promptedSessions.add("sess_acp");
+    await setConfigOptionHandler(server, { sessionId: "sess_acp", configId: "mode", value: "plan" }, cx);
+    expect(backend.modeCalls).toEqual(["plan"]);
+    expect(backend.modeNow).toBe("yolo");
+  });
+});
