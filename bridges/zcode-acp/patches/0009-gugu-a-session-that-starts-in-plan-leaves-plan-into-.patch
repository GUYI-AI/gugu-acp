--- a/src/config/options.ts
+++ b/src/config/options.ts
@@ -680,6 +680,31 @@ export async function buildConfigOptions(
  * Returns `{ kind, currentValue, options }` so the caller can emit the update
  * notifications, or null when the configId is unknown / model switch fails.
  */
+/**
+ * Switch the backend's mode, the one path for session/set_mode and
+ * set_config_option(mode).
+ *
+ * Plan is an execution-state flag over an underlying mode, and approving the
+ * plan (ExitPlanMode) returns the session to that underlying mode. A session
+ * that STARTS in plan has never chosen one, so it would leave plan into the
+ * bridge's default, yolo: everything runs unasked right after "approve". Such
+ * a session gets build (ask before edits and commands) underneath. A switch to
+ * plan mid-session (after a prompt) keeps the mode the user was in.
+ */
+export async function backendSetMode(
+  server: ZcodeAcpServer,
+  zcodeSid: string,
+  acpSid: string | undefined,
+  mode: string,
+): Promise<{ result?: unknown; error?: { message?: string } }> {
+  const backend = await server.ensureBackend();
+  if (mode === "plan" && acpSid !== undefined && !server.promptedSessions.has(acpSid)) {
+    const under = await backend.request(server.nextId(), "session/setMode", { sessionId: zcodeSid, mode: "build" }, 15000);
+    if (under.error) return under;
+  }
+  return backend.request(server.nextId(), "session/setMode", { sessionId: zcodeSid, mode }, 15000);
+}
