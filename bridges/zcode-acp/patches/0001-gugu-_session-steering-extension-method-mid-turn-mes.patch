diff --git a/tests/steering.test.ts b/tests/steering.test.ts
new file mode 100644
index 0000000..dbb1049
--- /dev/null
+++ b/tests/steering.test.ts
@@ -0,0 +1,77 @@
+import { describe, expect, it, vi } from "vitest";
+
+import { steering } from "../src/handlers/steering.js";
+import type { ZcodeAcpServer } from "../src/server.js";
+
+function makeServer(opts: { running: boolean; ack?: Record<string, unknown>; error?: { message: string } }) {
+  const requests: Array<{ method: string; params: Record<string, unknown> }> = [];
+  let id = 0;
+  const server = {
+    resolveSid: (sid: string) => (sid === "acp_a" ? "sess_z" : undefined),
+    pendingTurns: new Map(opts.running ? [["req0", { zcodeSid: "sess_z" }]] : []),
+    nextId: () => ++id,
+    ensureBackend: async () => ({
+      request: async (rid: number, method: string, params: Record<string, unknown>) => {
+        requests.push({ method, params });
+        return opts.error ? { id: rid, error: opts.error } : { id: rid, result: opts.ack ?? { status: "accepted" } };
+      },
+    }),
+  } as unknown as ZcodeAcpServer;
+  return { server, requests };
+}
+
+const text = (t: string) => [{ type: "text", text: t }];
+
+describe("_session/steering", () => {
+  it("guides the message into the running turn via the backend's own guide delivery", async () => {
+    const { server, requests } = makeServer({ running: true });
+    const startTurn = vi.fn();
+    const out = await steering(server, { sessionId: "acp_a", prompt: text("also say BANANA") }, startTurn);
+    expect(out).toEqual({ outcome: "injected" });
+    expect(startTurn).not.toHaveBeenCalled();
+    expect(requests).toHaveLength(1);
+    expect(requests[0]?.method).toBe("v4/command");
+    expect(requests[0]?.params).toMatchObject({
+      sessionId: "sess_z",
+      type: "sendText",
+      payload: { text: "also say BANANA", requestedDelivery: "guide" },
+    });
+  });
+
+  it("answers promptRequired when idle and the client opted in", async () => {
+    const { server, requests } = makeServer({ running: false });
+    const startTurn = vi.fn();
+    const out = await steering(
+      server,
+      { sessionId: "acp_a", prompt: text("hi"), _meta: { steering: { idleBehavior: "promptRequired" } } },
+      startTurn,
+    );
+    expect(out).toEqual({ outcome: "promptRequired", reason: "noRunningTurn" });
+    expect(startTurn).not.toHaveBeenCalled();
+    expect(requests).toHaveLength(0);
+  });
+
+  it("starts a new turn fire-and-forget when idle without opt-in", async () => {
+    const { server, requests } = makeServer({ running: false });
+    const startTurn = vi.fn(() => new Promise(() => {}));
+    const out = await steering(server, { sessionId: "acp_a", prompt: text("hi") }, startTurn);
+    expect(out).toEqual({ outcome: "startedNewTurn" });
+    expect(startTurn).toHaveBeenCalledWith(text("hi"));
+    expect(requests).toHaveLength(0);
+  });
+
+  it("fails loudly when the backend rejects the steer", async () => {
+    const { server } = makeServer({ running: true, ack: { status: "rejected", reasonCode: "session_closed" } });
+    await expect(steering(server, { sessionId: "acp_a", prompt: text("x") }, vi.fn())).rejects.toThrow(
+      /steer rejected \(session_closed\)/,
+    );
+  });
+
+  it("rejects non-text blocks and empty prompts", async () => {
+    const { server } = makeServer({ running: true });
+    await expect(
+      steering(server, { sessionId: "acp_a", prompt: [{ type: "image", data: "", mimeType: "image/png" }] }, vi.fn()),
+    ).rejects.toThrow(/text only/);
+    await expect(steering(server, { sessionId: "acp_a", prompt: [] }, vi.fn())).rejects.toThrow(/requires a text prompt/);
+  });
+});
