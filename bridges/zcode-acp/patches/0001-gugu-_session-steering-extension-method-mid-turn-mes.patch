--- /dev/null
+++ b/src/handlers/steering.ts
@@ -0,0 +1,93 @@
+/**
+ * `_session/steering` — inject a message into the RUNNING turn.
+ *
+ * Same method name and contract as @agentclientprotocol/claude-agent-acp's
+ * extension (and pi-acp's): `injected` while a turn runs; when idle,
+ * `promptRequired` (+ reason `noRunningTurn`) if the client opted in via
+ * `_meta.steering.idleBehavior: "promptRequired"`, else a new turn is started
+ * fire-and-forget and the answer is `startedNewTurn`.
+ *
+ * The running case uses the backend's own steer path: `v4/command sendText`
+ * with `requestedDelivery: "guide"` — the app-server folds the text into the
+ * running turn at its next tool boundary (one turn, no cancellation; verified
+ * live against app-server 0.16.9). A second `session/prompt` instead preempts
+ * the in-flight prompt, which then reports `cancelled` although its work went
+ * on — wrong for a client that only meant to add a message.
+ */
+
+import { randomUUID } from "node:crypto";
+
+import type * as acp from "@agentclientprotocol/sdk";
+import { RequestError } from "@agentclientprotocol/sdk";
+
+import type { ZcodeAcpServer } from "../server.js";
+import { log } from "../utils.js";
+
+export type SteeringOutcome =
+  | { outcome: "injected" }
+  | { outcome: "promptRequired"; reason: "noRunningTurn" }
+  | { outcome: "startedNewTurn" };
+
+export interface SteeringParams {
+  sessionId: string;
+  prompt?: unknown;
+  _meta?: unknown;
+}
+
+/** Concatenate the text of the steering message; only text-like blocks steer. */
+export function steeringText(prompt: unknown): string {
+  if (!Array.isArray(prompt)) return "";
+  const parts: string[] = [];
+  for (const block of prompt as acp.ContentBlock[]) {
+    if (block.type === "text") parts.push(block.text);
+    else if (block.type === "resource" && "text" in block.resource) parts.push(block.resource.text);
+    else throw RequestError.invalidParams(undefined, `_session/steering accepts text only (got ${block.type})`);
+  }
+  return parts.join("\n\n");
+}
+
+export async function steering(
+  server: ZcodeAcpServer,
+  params: SteeringParams,
+  startTurn: (prompt: acp.ContentBlock[]) => Promise<unknown>,
+): Promise<SteeringOutcome> {
+  const text = steeringText(params.prompt);
+  if (!text.trim()) throw RequestError.invalidParams(undefined, "_session/steering requires a text prompt");
+  const zcodeSid = server.resolveSid(params.sessionId);
+  const running =
+    zcodeSid !== undefined && [...server.pendingTurns.values()].some((t) => t.zcodeSid === zcodeSid);
+
+  if (!running) {
+    const meta = params._meta as { steering?: { idleBehavior?: string } } | undefined;
+    if (meta?.steering?.idleBehavior === "promptRequired") {
+      return { outcome: "promptRequired", reason: "noRunningTurn" };
+    }
+    // Fire-and-forget: the steering answer must not wait for a whole turn.
+    startTurn(params.prompt as acp.ContentBlock[]).catch((e: unknown) =>
+      log(`[steering] idle turn failed: ${e instanceof Error ? e.message : String(e)}`),
+    );
+    return { outcome: "startedNewTurn" };
+  }
+
+  const backend = await server.ensureBackend();
+  const resp = await backend.request(server.nextId(), "v4/command", {
+    commandId: randomUUID(),
+    clientId: "zcode-acp-server",
+    sessionId: zcodeSid,
+    type: "sendText",
+    payload: { text, requestedDelivery: "guide" },
+    issuedAt: Date.now(),
+  });
+  if (resp.error) {
+    throw RequestError.internalError(undefined, `steer failed: ${resp.error.message ?? "unknown error"}`);
+  }
+  const ack = (resp.result ?? {}) as { status?: string; reasonCode?: string };
+  if (ack.status !== "accepted" && ack.status !== "duplicate") {
+    throw RequestError.internalError(
+      undefined,
+      `steer ${ack.status ?? "failed"}${ack.reasonCode ? ` (${ack.reasonCode})` : ""}`,
+    );
+  }
+  log(`[steering] guided into running turn of ${zcodeSid}`);
+  return { outcome: "injected" };
+}
