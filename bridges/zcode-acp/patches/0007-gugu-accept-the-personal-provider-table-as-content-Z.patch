diff --git a/src/config/provider-table-content.ts b/src/config/provider-table-content.ts
new file mode 100644
index 0000000..fcc3b00
--- /dev/null
+++ b/src/config/provider-table-content.ts
@@ -0,0 +1,47 @@
+/**
+ * A personal provider table handed in through the environment (gugu).
+ *
+ * A host that gives one bridge process its own provider table (gugu: a
+ * platform session on the gugu model gateway) passes the whole table as
+ * ZCODE_PERSONAL_PROVIDER_CONFIG_CONTENT, the way it already hands other
+ * harnesses a config document in one variable. The ZCode backend only reads
+ * a file, so the bridge writes the content once, at startup, into a private
+ * 0600 file in a fresh 0700 directory, points ZCODE_PERSONAL_PROVIDER_CONFIG_FILE
+ * at it (which zcodePersonalProviderPath() and the backend spawn then honour),
+ * drops the content variable from its own environment so children never
+ * inherit it, and deletes the file when the process exits.
+ */
+
+import { mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import path from "node:path";
+import process from "node:process";
+
+export const PROVIDER_TABLE_CONTENT_ENV = "ZCODE_PERSONAL_PROVIDER_CONFIG_CONTENT";
+
+/**
+ * Materialize the table from the environment. Returns the written path, or
+ * null when the variable is unset. Invalid JSON throws: a host that meant to
+ * pin the provider must not silently fall back to the user's own table.
+ */
+export function materializeProviderTableFromEnv(
+  env: NodeJS.ProcessEnv = process.env,
+  onExit: (cleanup: () => void) => void = (cleanup) => process.once("exit", cleanup),
+): string | null {
+  const content = env[PROVIDER_TABLE_CONTENT_ENV]?.trim();
+  if (!content) return null;
+  try {
+    JSON.parse(content);
+  } catch (e) {
+    throw new Error(
+      `${PROVIDER_TABLE_CONTENT_ENV} is not valid JSON: ${e instanceof Error ? e.message : String(e)}`,
+    );
+  }
+  const dir = mkdtempSync(path.join(tmpdir(), "zcode-acp-provider-"));
+  const file = path.join(dir, "provider_config.json");
+  writeFileSync(file, content, { mode: 0o600 });
+  env.ZCODE_PERSONAL_PROVIDER_CONFIG_FILE = file;
+  delete env[PROVIDER_TABLE_CONTENT_ENV];
+  onExit(() => rmSync(dir, { recursive: true, force: true }));
+  return file;
+}
