diff --git a/tests/provider-table-content.test.ts b/tests/provider-table-content.test.ts
new file mode 100644
index 0000000..5df5d6b
--- /dev/null
+++ b/tests/provider-table-content.test.ts
@@ -0,0 +1,39 @@
+import { existsSync, readFileSync, statSync } from "node:fs";
+import path from "node:path";
+import { describe, expect, it } from "vitest";
+
+import {
+  PROVIDER_TABLE_CONTENT_ENV,
+  materializeProviderTableFromEnv,
+} from "../src/config/provider-table-content.js";
+
+describe("provider table handed in through the environment", () => {
+  it("writes a private 0600 file, points the backend variable at it, drops the content, cleans up on exit", () => {
+    const table = JSON.stringify({ schemaVersion: 1, config: { providerConfigRules: { providerRules: [] } } });
+    const env: NodeJS.ProcessEnv = { [PROVIDER_TABLE_CONTENT_ENV]: table };
+    let cleanup: (() => void) | undefined;
+    const file = materializeProviderTableFromEnv(env, (fn) => {
+      cleanup = fn;
+    });
+    expect(file).not.toBeNull();
+    expect(env.ZCODE_PERSONAL_PROVIDER_CONFIG_FILE).toBe(file);
+    expect(env[PROVIDER_TABLE_CONTENT_ENV]).toBeUndefined();
+    expect(readFileSync(file!, "utf8")).toBe(table);
+    expect(statSync(file!).mode & 0o777).toBe(0o600);
+    expect(statSync(path.dirname(file!)).mode & 0o777).toBe(0o700);
+    cleanup!();
+    expect(existsSync(path.dirname(file!))).toBe(false);
+  });
+
+  it("does nothing without the variable", () => {
+    const env: NodeJS.ProcessEnv = {};
+    expect(materializeProviderTableFromEnv(env, () => {})).toBeNull();
+    expect(env.ZCODE_PERSONAL_PROVIDER_CONFIG_FILE).toBeUndefined();
+  });
+
+  it("fails loudly on content that is not JSON (never falls back to the user's table)", () => {
+    const env: NodeJS.ProcessEnv = { [PROVIDER_TABLE_CONTENT_ENV]: "{not json" };
+    expect(() => materializeProviderTableFromEnv(env, () => {})).toThrow(/is not valid JSON/);
+    expect(env.ZCODE_PERSONAL_PROVIDER_CONFIG_FILE).toBeUndefined();
+  });
+});
