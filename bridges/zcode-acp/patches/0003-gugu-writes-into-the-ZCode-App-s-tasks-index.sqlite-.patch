@@ -51,6 +51,18 @@ async function loadSqlite(): Promise<DatabaseSyncCtor | null> {
   return DatabaseSync;
 }
 
+/**
+ * Writes into the ZCode App's own tasks-index.sqlite are opt-in (gugu build):
+ * with them, every ACP session shows up — and is renamed / soft-deleted — in
+ * the user's ZCode desktop task list, by writing another app's database
+ * outside the ZCode protocol. A client that only drives the agent (Gugu) must
+ * leave that list alone, so writes happen only with
+ * ZCODE_ACP_TASKS_INDEX_WRITES=1. Reads (hidden ids, titles, workspaces) stay.
+ */
+export function appIndexWritesEnabled(env: NodeJS.ProcessEnv = process.env): boolean {
+  return env.ZCODE_ACP_TASKS_INDEX_WRITES === "1";
+}
+
 /** tasks-index.sqlite sits next to config.json under ~/.zcode/v2/. */
 const TASKS_INDEX_PATH = path.join(path.dirname(ZCODE_CREDS_PATH), "tasks-index.sqlite");
 
