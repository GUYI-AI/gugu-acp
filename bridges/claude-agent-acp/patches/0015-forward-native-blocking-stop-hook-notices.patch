diff --git a/src/stop-hook-notices.ts b/src/stop-hook-notices.ts
new file mode 100644
index 0000000..e118f95
--- /dev/null
+++ b/src/stop-hook-notices.ts
@@ -0,0 +1,28 @@
+import type { SDKHookResponseMessage } from "@anthropic-ai/claude-agent-sdk";
+
+/** Only the CLI's completed command-hook response can establish a Stop block. */
+export function blockingStopNotice(message: SDKHookResponseMessage): string | null {
+  if (message.hook_event !== "Stop" || message.outcome !== "success" || message.exit_code !== 0) {
+    return null;
+  }
+  let output: { decision?: unknown; reason?: unknown; systemMessage?: unknown } | null;
+  try {
+    output = JSON.parse(message.stdout);
+  } catch {
+    return null;
+  }
+  if (
+    output?.decision !== "block" ||
+    typeof output.reason !== "string" ||
+    !output.reason.trim() ||
+    // Claude Code already sends this on its informational lane.
+    (typeof output.systemMessage === "string" && output.systemMessage.trim())
+  ) {
+    return null;
+  }
+  return output.reason
+    .trim()
+    .split(/\r?\n/)
+    .map((line) => (line.trim() ? `Stop says: ${line}` : ""))
+    .join("\n");
+}
diff --git a/src/tests/stop-hook-notice.test.ts b/src/tests/stop-hook-notice.test.ts
