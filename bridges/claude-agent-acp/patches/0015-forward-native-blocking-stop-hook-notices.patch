diff --git a/src/tests/stop-hook-notice.test.ts b/src/tests/stop-hook-notice.test.ts
new file mode 100644
index 0000000..b86ab87
--- /dev/null
+++ b/src/tests/stop-hook-notice.test.ts
@@ -0,0 +1,214 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import type { Options } from "@anthropic-ai/claude-agent-sdk";
+import { ClaudeAcpAgent, type AcpClient } from "../acp-agent.js";
+import { Pushable } from "../utils.js";
+import { initializeClient } from "./helpers.js";
+import {
+  mockSessionState,
+  successfulResultMessage,
+  userEcho,
+  wrapQuery,
+} from "./session-doubles.js";
+
+let capturedOptions: Options | undefined;
+vi.mock("@anthropic-ai/claude-agent-sdk", async () => {
+  const actual = await vi.importActual<typeof import("@anthropic-ai/claude-agent-sdk")>(
+    "@anthropic-ai/claude-agent-sdk",
+  );
+  const { makeMockQuery } = await import("./helpers.js");
+  return {
+    ...actual,
+    query: (args: { options: Options }) => {
+      capturedOptions = args.options;
+      return makeMockQuery();
+    },
+  };
+});
+
+// Captured from command Stop hooks on CLI 2.1.293 and 2.1.312. The
+// decision/reason JSON is on stdout; no informational frame accompanies it.
+const response = (output: unknown, overrides: Record<string, unknown> = {}) => ({
+  type: "system",
+  subtype: "hook_response",
+  hook_id: "stop-1",
+  hook_name: "Stop",
+  hook_event: "Stop",
+  stdout: JSON.stringify(output) + "\n",
+  output: JSON.stringify(output) + "\n",
+  stderr: "",
+  exit_code: 0,
+  outcome: "success",
+  uuid: "response-1",
+  session_id: "test-session",
+  ...overrides,
+});
+const blocked = { decision: "block", reason: "Check the result.\nThen continue." };
+const answer = (text: string) => ({
+  type: "assistant",
+  uuid: text,
+  parent_tool_use_id: null,
+  session_id: "test-session",
+  message: {
+    id: text,
+    role: "assistant",
+    model: "claude-sonnet-4-6",
+    content: [{ type: "text", text }],
+    usage: {
+      input_tokens: 0,
+      output_tokens: 0,
+      cache_read_input_tokens: 0,
+      cache_creation_input_tokens: 0,
+    },
+  },
+});
+
+describe("native blocking Stop notices", () => {
+  let agent: ClaudeAcpAgent;
+  let updates: any[];
+  beforeEach(() => {
+    capturedOptions = undefined;
+    updates = [];
+    agent = new ClaudeAcpAgent(
+      {
+        sessionUpdate: async (n: unknown) => {
+          updates.push(n);
+        },
+      } as AcpClient,
+      { log: () => {}, error: () => {} },
+    );
+  });
+  afterEach(async () => {
+    await agent.dispose();
+  });
+
+  async function consume(messages: any[], notices = true, cancelled = false) {
+    await initializeClient(agent, notices ? { session: { notices: {} } } : {});
+    const input = new Pushable<any>();
+    async function* stream() {
+      const { value } = await input[Symbol.asyncIterator]().next();
+      yield userEcho(value);
+      if (cancelled) agent.sessions["test-session"].cancelled = true;
+      yield* messages;
+      yield successfulResultMessage();
+      yield { type: "system", subtype: "session_state_changed", state: "idle" };
+    }
+    agent.sessions["test-session"] = mockSessionState({ input, query: wrapQuery(stream()) });
+    await agent.prompt({ sessionId: "test-session", prompt: [{ type: "text", text: "continue" }] });
+    return updates.map((n) => n.update);
+  }
+
+  it("enables native lifecycle frames for ordinary sessions", async () => {
+    await agent.newSession({ cwd: process.cwd(), mcpServers: [] });
+    expect(capturedOptions?.includeHookEvents).toBe(true);
+  });
+
+  it("publishes one notice between the completed answer and its continuation", async () => {
+    const out = await consume([answer("Before Stop."), response(blocked), answer("After Stop.")]);
+    const visible = out.filter(
+      (u) => u.sessionUpdate === "notice" || u.sessionUpdate === "agent_message_chunk",
+    );
+    expect(visible).toEqual([
+      expect.objectContaining({
+        sessionUpdate: "agent_message_chunk",
+        content: expect.objectContaining({ text: "Before Stop." }),
+      }),
+      {
+        sessionUpdate: "notice",
+        severity: "info",
+        title: "Stop says: Check the result.",
+        description: "Stop says: Then continue.",
+      },
+      expect.objectContaining({
+        sessionUpdate: "agent_message_chunk",
+        content: expect.objectContaining({ text: "After Stop." }),
+      }),
+    ]);
+  });
+
+  it("marks the legacy transcript fallback as a provider notice", async () => {
+    const out = await consume([response(blocked)], false);
+    expect(out).toContainEqual({
+      sessionUpdate: "agent_message_chunk",
+      content: {
+        type: "text",
+        text: "**Notice:** Stop says: Check the result.\nStop says: Then continue.",
+      },
+      _meta: { claudeCode: { kind: "informational", level: "notice" } },
+    });
+  });
+
+  it("does not duplicate the CLI's systemMessage notice", async () => {
+    const out = await consume([
+      response({ ...blocked, systemMessage: "Visible message" }),
+      {
+        type: "system",
+        subtype: "informational",
+        content: "Stop says: Visible message",
+        level: "notice",
+        session_id: "test-session",
+      },
+    ]);
+    expect(out.filter((u) => u.sessionUpdate === "notice")).toEqual([
+      { sessionUpdate: "notice", severity: "info", title: "Stop says: Visible message" },
+    ]);
+  });
+
+  it("still reports a block when systemMessage is empty", async () => {
+    const out = await consume([response({ ...blocked, systemMessage: "" })]);
+    expect(out.filter((u) => u.sessionUpdate === "notice")).toHaveLength(1);
+  });
+
+  it("leaves a whitespace systemMessage to the CLI's informational lane", async () => {
+    const out = await consume([
+      response({ ...blocked, systemMessage: "   " }),
+      {
+        type: "system",
+        subtype: "informational",
+        content: "Stop says:    ",
+        level: "notice",
+        session_id: "test-session",
+      },
+    ]);
+    expect(out.filter((u) => u.sessionUpdate === "notice")).toHaveLength(1);
+  });
+
+  it("keeps long multiline reasons on the Stop notice lane", async () => {
+    const reason = "x".repeat(300) + "\n\nReview the answer.";
+    const out = await consume([response({ decision: "block", reason })]);
+    expect(out).toContainEqual({
+      sessionUpdate: "notice",
+      severity: "info",
+      title: "Stop says: Completion blocked",
+      description: `Stop says: ${"x".repeat(300)}\n\nStop says: Review the answer.`,
+    });
+  });
+
+  it("drops late hook responses after cancellation", async () => {
+    const out = await consume([response(blocked)], true, true);
+    expect(out.filter((u) => u.sessionUpdate === "notice")).toEqual([]);
+  });
+
+  it("deduplicates the same native hook id, but keeps later distinct blocks", async () => {
+    const out = await consume([
+      response(blocked),
+      response(blocked),
+      response(blocked, { hook_id: "stop-2" }),
+    ]);
+    expect(out.filter((u) => u.sessionUpdate === "notice")).toHaveLength(2);
+  });
+
+  it.each([
+    response(blocked, { hook_event: "PreToolUse" }),
+    response(blocked, { outcome: "cancelled" }),
+    response(blocked, { exit_code: 1, outcome: "error" }),
+    response({ decision: "approve", reason: "not blocking" }),
+    response({ ...blocked, continue: false }),
+    response({ decision: "block", reason: 123 }),
+    response({ decision: "block", reason: "  " }),
+    response(blocked, { stdout: "not JSON" }),
+    answer("A Stop hook says: block. This is only ordinary assistant prose."),
+  ])("does not invent a Stop boundary from unrelated output %#", async (frame) => {
+    const out = await consume([frame]);
+    expect(out.filter((u) => u.sessionUpdate === "notice")).toEqual([]);
+  });
+});
