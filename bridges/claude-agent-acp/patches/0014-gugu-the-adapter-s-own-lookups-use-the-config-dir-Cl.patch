diff --git a/src/paths.ts b/src/paths.ts
index 1a5834e..1a2419c 100644
--- a/src/paths.ts
+++ b/src/paths.ts
@@ -1,7 +1,32 @@
 import * as os from "node:os";
 import * as path from "node:path";
 
-/** The Claude configuration directory: `CLAUDE_CONFIG_DIR`, or `~/.claude`. */
+/** The directory Claude Code itself reported (see {@link noteTranscriptPath}). */
+let reportedConfigDir: string | undefined;
+
+/**
+ * The Claude configuration directory: the one Claude Code reported, else
+ * `CLAUDE_CONFIG_DIR`, else `~/.claude`. A `claude` wrapper may set
+ * `CLAUDE_CONFIG_DIR` inside its own process, out of this adapter's sight;
+ * what the CLI reports is where it actually writes.
+ */
 export function claudeConfigDir(): string {
-  return process.env.CLAUDE_CONFIG_DIR ?? path.join(os.homedir(), ".claude");
+  return reportedConfigDir ?? process.env.CLAUDE_CONFIG_DIR ?? path.join(os.homedir(), ".claude");
+}
+
+/**
+ * Learns the configuration directory from a transcript path the CLI reported
+ * in hook input: `<config>/projects/<encoded cwd>/<session id>.jsonl`. A path of
+ * another shape teaches nothing.
+ */
+export function noteTranscriptPath(transcriptPath: string): void {
+  if (!transcriptPath.endsWith(".jsonl")) return;
+  const projects = path.dirname(path.dirname(transcriptPath));
+  if (path.basename(projects) !== "projects") return;
+  reportedConfigDir = path.dirname(projects);
+}
+
+/** TEST-ONLY */
+export function resetReportedConfigDirForTests(): void {
+  reportedConfigDir = undefined;
 }
diff --git a/src/tests/paths.test.ts b/src/tests/paths.test.ts
new file mode 100644
index 0000000..7011f80
--- /dev/null
+++ b/src/tests/paths.test.ts
@@ -0,0 +1,31 @@
+import { afterEach, describe, expect, it } from "vitest";
+import * as os from "node:os";
+import * as path from "node:path";
+import { claudeConfigDir, noteTranscriptPath, resetReportedConfigDirForTests } from "../paths.js";
+
+describe("claudeConfigDir", () => {
+  const saved = process.env.CLAUDE_CONFIG_DIR;
+  afterEach(() => {
+    resetReportedConfigDirForTests();
+    if (saved === undefined) delete process.env.CLAUDE_CONFIG_DIR;
+    else process.env.CLAUDE_CONFIG_DIR = saved;
+  });
+
+  it("prefers the directory the CLI reported over the adapter's own environment", () => {
+    delete process.env.CLAUDE_CONFIG_DIR;
+    expect(claudeConfigDir()).toBe(path.join(os.homedir(), ".claude"));
+    process.env.CLAUDE_CONFIG_DIR = "/from/env";
+    expect(claudeConfigDir()).toBe("/from/env");
+
+    noteTranscriptPath(path.join("/wrapped/config", "projects", "-work-repo", "abc.jsonl"));
+    expect(claudeConfigDir()).toBe("/wrapped/config");
+  });
+
+  it("learns nothing from a path of another shape", () => {
+    process.env.CLAUDE_CONFIG_DIR = "/from/env";
+    noteTranscriptPath("/wrapped/config/elsewhere/-work/abc.jsonl");
+    noteTranscriptPath("/wrapped/config/projects/-work/abc.txt");
+    noteTranscriptPath("");
+    expect(claudeConfigDir()).toBe("/from/env");
+  });
+});
