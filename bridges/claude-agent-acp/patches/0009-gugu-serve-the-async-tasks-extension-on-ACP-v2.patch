-export function clientSupportsAsyncTasks(capabilities?: ClientCapabilities | null): boolean {
-  return clientSupportsAirCapability(capabilities, AIR_ASYNC_TASKS_CAPABILITY);
+/**
+ * Whether the client takes the async tasks extension: AIR declares it among
+ * its capabilities. An ACP v2 client, which is not AIR, declares it with
+ * `_meta.asyncTasks`, and gets its updates with a leading `_`, as v2 names an
+ * extension's update kinds. (v1 has no such kinds, so there it stays AIR's.)
+ */
+export function clientSupportsAsyncTasks(
+  capabilities: ClientCapabilities | null | undefined,
+  v2: boolean,
+): boolean {
+  const declared = capabilities?._meta?.[AIR_ASYNC_TASKS_CAPABILITY];
+  return (
+    clientSupportsAirCapability(capabilities, AIR_ASYNC_TASKS_CAPABILITY) ||
+    (v2 && typeof declared === "object" && declared !== null && !Array.isArray(declared))
+  );
 }
 
 /** Publishes Claude's non-agent background work as a separate AIR task lifecycle. */
diff --git a/src/tests/acp-v2.test.ts b/src/tests/acp-v2.test.ts
index 76e6e85..dc07bab 100644
--- a/src/tests/acp-v2.test.ts
+++ b/src/tests/acp-v2.test.ts
@@ -5599,4 +5599,55 @@ describe("ACP v2 extensions", () => {
       "idle end_turn",
     ]);
   });
+
+  it("reports a background command as an async task to a client that declares the extension, and stops it", async () => {
+    const stopped: string[] = [];
+    sdk.stopTask = async (taskId) => {
+      stopped.push(taskId);
+    };
+    scriptTurns(async function* (options) {
+      yield {
+        type: "system",
+        subtype: "task_started",
+        task_id: "bash_1",
+        task_type: "local_bash",
+        description: "sleep 100",
+        tool_use_id: "toolu_bg",
+        is_backgrounded: true,
+        uuid: randomUUID(),
+        session_id: options.sessionId,
+      };
+      yield result(options);
+      yield idleState(options);
+    });
+    const client = v2Client();
+    await client.app.connectWith(connectRouter(), async (agent) => {
+      await initializeV2(agent, { _meta: { asyncTasks: {} } });
+      const { sessionId } = await agent.request(v2.methods.agent.session.new, { cwd });
+      await agent.request(v2.methods.agent.session.prompt, { sessionId, prompt: text("hi") });
+      await vi.waitFor(() => expect(client.updates("_async_task_spawned")).toHaveLength(1));
+
+      expect(
+        await agent.request("_session/async_task/stop", { sessionId, asyncTaskId: "bash_1" }),
+      ).toEqual({ stopped: true });
+      await vi.waitFor(() =>
+        expect(client.updates("_async_task_state_update")).toContainEqual(
+          expect.objectContaining({ asyncTaskId: "bash_1", state: "stopped" }),
+        ),
+      );
+      await client.authUpdate(1);
+    });
+
+    expect(stopped).toEqual(["bash_1"]);
+    expect(client.updates("_async_task_spawned")[0]).toMatchObject({
+      asyncTaskId: "bash_1",
+      canStop: true,
+    });
+    // v2 reports the session's own work as state, not as an async task.
+    expect(
+      client
+        .updates("_async_task_spawned")
+        .filter((task) => (task as { taskType?: string }).taskType === "turn"),
+    ).toEqual([]);
+  });
 });
