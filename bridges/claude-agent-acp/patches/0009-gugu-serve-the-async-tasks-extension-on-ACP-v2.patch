diff --git a/src/async-tasks.ts b/src/async-tasks.ts
index 3c390dc..93378f4 100644
--- a/src/async-tasks.ts
+++ b/src/async-tasks.ts
@@ -109,8 +109,21 @@ type BackgroundTaskLevel = TaskIdentity & {
   description?: unknown;
