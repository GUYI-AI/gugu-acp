@@ -0,0 +1,56 @@
+import { describe, it, expect } from "vitest";
+import type { ModelInfo } from "@anthropic-ai/claude-agent-sdk";
+import {
+  ULTRACODE_EFFORT_ID,
+  buildEffortConfigOption,
+  effortFlagSettings,
+  toSdkEffortLevel,
+} from "../session-effort.js";
+
+const MODEL: ModelInfo = {
+  value: "opus",
+  displayName: "Opus",
+  description: "",
+  supportsEffort: true,
+  supportedEffortLevels: ["low", "medium", "high", "xhigh", "max"],
+};
+
+const values = (option: ReturnType<typeof buildEffortConfigOption>) =>
+  option?.type === "select"
+    ? option.options.flatMap((o) => ("value" in o ? [o.value] : o.options.map((n) => n.value)))
+    : [];
+
+describe("UltraCode effort row (Gugu)", () => {
+  it("is offered exactly while upstream offers the ultracode toggle", () => {
+    const on = { supported: true };
+    const off = { supported: false };
+    expect(values(buildEffortConfigOption([MODEL], "opus", "high", false, on))).toContain(
+      ULTRACODE_EFFORT_ID,
+    );
+    expect(values(buildEffortConfigOption([MODEL], "opus", "high", false, off))).not.toContain(
+      ULTRACODE_EFFORT_ID,
+    );
+    expect(values(buildEffortConfigOption([MODEL], "opus", "high", false))).not.toContain(
+      ULTRACODE_EFFORT_ID,
+    );
+  });
+
+  it("is a valid current value where supported, and clamps where it is not", () => {
+    expect(
+      buildEffortConfigOption([MODEL], "opus", ULTRACODE_EFFORT_ID, false, { supported: true })
+        ?.currentValue,
+    ).toBe(ULTRACODE_EFFORT_ID);
+    expect(
+      buildEffortConfigOption([MODEL], "opus", ULTRACODE_EFFORT_ID, false, { supported: false })
+        ?.currentValue,
+    ).toBe("default");
+  });
+
+  it("is never sent to the CLI as an effort level", () => {
+    expect(toSdkEffortLevel(ULTRACODE_EFFORT_ID)).toBeNull();
+    expect(effortFlagSettings(ULTRACODE_EFFORT_ID, true)).toEqual({
+      effortLevel: null,
+      ultracode: true,
+    });
+  });
+});
