diff --git a/src/tests/acp-agent.test.ts b/src/tests/acp-agent.test.ts
index 20bd39c..40d5fcb 100644
--- a/src/tests/acp-agent.test.ts
+++ b/src/tests/acp-agent.test.ts
@@ -18397,6 +18397,68 @@ describe("turn steering (_session/steering)", () => {
     expect(captured[0].priority).toBe("next");
   });
 
+  it("injects into a cycle the model started on its own, and only while it runs", async () => {
+    const timeline: string[] = [];
+    const agent = new ClaudeAcpAgent(timelineClient(timeline), { log: () => {}, error: () => {} });
+    const captured: any[] = [];
+    let notify!: () => void;
+    const notified = new Promise<void>((resolve) => (notify = resolve));
+    let autonomousRunning = false;
+    injectGeneratorSession(agent, (input) => {
+      async function* messageGenerator() {
+        const iter = input[Symbol.asyncIterator]();
+        const u1 = await iter.next();
+        yield userEcho(u1.value);
+        yield { ...createResultMessage(), origin: { kind: "human" } };
+        yield idleMessage();
+        // A background task finishes: the CLI runs a task-notification cycle
+        // with no host turn queued (as read on CLI 2.1.296).
+        await notified;
+        yield { type: "system", subtype: "session_state_changed", state: "running" };
+        autonomousRunning = true;
+        const steered = await iter.next();
+        captured.push(steered.value);
+        yield userEcho(steered.value);
+        yield createAssistantText("finished steered");
+        yield {
+          ...createResultMessage(),
+          origin: { kind: "task-notification" },
+          user_message_uuids: [steered.value.uuid],
+        };
+        yield idleMessage();
+        await iter.next(); // the session stays open
+      }
+      return messageGenerator();
+    });
+
+    await expect(
+      agent.prompt({ sessionId: "test-session", prompt: [{ type: "text", text: "start" }] }),
+    ).resolves.toEqual(expect.objectContaining({ stopReason: "end_turn" }));
+    notify();
+    await waitFor(() => autonomousRunning);
+
+    const steer = (text: string) =>
+      agent.steer({
+        sessionId: "test-session",
+        prompt: [{ type: "text", text }],
+        _meta: { steering: { idleBehavior: "promptRequired", delivery: "next" } },
+      });
+    await expect(steer("also say steered")).resolves.toEqual({ outcome: "injected" });
+    expect(agent.sessions["test-session"].turnQueue).toHaveLength(0);
+    await waitFor(() => timeline.includes("finished steered"));
+    expect(captured).toHaveLength(1);
+    expect(captured[0].priority).toBe("next");
+    expect(JSON.stringify(captured[0].message.content)).toContain("also say steered");
+
+    // That cycle is over: the content stays Host-owned again.
+    await waitFor(() => agent.sessions["test-session"].lastSessionState === "idle");
+    await expect(steer("too late")).resolves.toEqual({
+      outcome: "promptRequired",
+      reason: "noRunningTurn",
+    });
+    expect(captured).toHaveLength(1);
+  });
+
