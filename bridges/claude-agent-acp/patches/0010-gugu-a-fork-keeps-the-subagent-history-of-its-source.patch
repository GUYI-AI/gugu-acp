+/**
+ * Gives the fork `forkId` of the session `sessionId` the subagent transcripts and
+ * metadata of its source. The SDK fork copies only the session transcript, and
+ * the fork keeps the source's tool use ids, so with these files a load of the
+ * fork finds the subagent each Agent call launched, as a load of the source does.
+ * A launch after the fork point is not in the fork, so its files go unread.
+ */
+export async function copySubagentHistory(sessionId: string, forkId: string): Promise<void> {
+  const source = await findTranscript(sessionId);
+  const fork = await findTranscript(forkId);
+  if (!source || !fork) return;
+  const from = subagentsDirectory(source, sessionId);
+  try {
+    await readdir(from);
+  } catch {
+    return; // The source launched no subagent.
+  }
+  await cp(from, subagentsDirectory(fork, forkId), {
+    recursive: true,
+    errorOnExist: true,
+    force: false,
+  });
+}
+
 /** The folder of the subagent transcripts, next to the session transcript `transcript`. */
 function subagentsDirectory(transcript: string, sessionId: string): string {
   return path.join(path.dirname(transcript), sessionId, "subagents");
