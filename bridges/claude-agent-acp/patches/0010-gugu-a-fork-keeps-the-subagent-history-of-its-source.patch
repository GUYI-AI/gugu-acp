+import { copySubagentHistory, stripForkPrefix, subagentLineage } from "../subagent-history.js";
 
 const sessionId = "33333333-3333-4333-8333-333333333333";
 const base = {
@@ -315,3 +315,49 @@ describe("stripForkPrefix", () => {
     expect(stripForkPrefix(messages)).toBe(messages);
   });
 });
+
+describe("copySubagentHistory", () => {
+  const forkId = "44444444-4444-4444-8444-444444444444";
+  let configDir: string;
+  let originalConfigDir: string | undefined;
+  beforeEach(async () => {
+    configDir = await mkdtemp(path.join(os.tmpdir(), "claude-acp-fork-history-"));
+    originalConfigDir = process.env.CLAUDE_CONFIG_DIR;
+    process.env.CLAUDE_CONFIG_DIR = configDir;
+  });
+  afterEach(async () => {
+    if (originalConfigDir === undefined) delete process.env.CLAUDE_CONFIG_DIR;
+    else process.env.CLAUDE_CONFIG_DIR = originalConfigDir;
+    await rm(configDir, { recursive: true, force: true });
+  });
+  const project = () => path.join(configDir, "projects", "-tmp-proj");
+
+  it("gives a fork the subagent transcripts and metadata of its source", async () => {
+    await mkdir(path.join(project(), sessionId, "subagents"), { recursive: true });
+    await writeFile(path.join(project(), `${sessionId}.jsonl`), "{}\n");
+    await writeFile(path.join(project(), `${forkId}.jsonl`), "{}\n");
+    await writeFile(path.join(project(), sessionId, "subagents", "agent-a1.jsonl"), "{}\n");
+    await writeFile(
+      path.join(project(), sessionId, "subagents", "agent-a1.meta.json"),
+      JSON.stringify(meta("toolu_launch", "worker")),
+    );
+
+    await copySubagentHistory(sessionId, forkId);
+
+    const copied = path.join(project(), forkId, "subagents");
+    expect((await readdir(copied)).sort()).toEqual(["agent-a1.jsonl", "agent-a1.meta.json"]);
+    expect(
+      JSON.parse(await readFile(path.join(copied, "agent-a1.meta.json"), "utf8")).toolUseId,
+    ).toBe("toolu_launch");
+  });
+
+  it("leaves a fork alone when its source launched no subagent", async () => {
+    await mkdir(project(), { recursive: true });
+    await writeFile(path.join(project(), `${sessionId}.jsonl`), "{}\n");
+    await writeFile(path.join(project(), `${forkId}.jsonl`), "{}\n");
+
+    await copySubagentHistory(sessionId, forkId);
+
+    expect(await readdir(project())).not.toContain(forkId);
+  });
+});
