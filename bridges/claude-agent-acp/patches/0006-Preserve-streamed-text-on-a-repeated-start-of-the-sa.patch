+    injectSession(agent, [
+      messageStart("resp-repeated-start"),
+      textDelta("61"),
+      messageStart("resp-repeated-start"),
+      assistantMessage("resp-repeated-start", [{ type: "text", text: "61" }]),
+      result(),
+      idle,
+    ]);
+
+    await agent.prompt({ sessionId: "test-session", prompt: [{ type: "text", text: "hi" }] });
+
+    expect(messageChunkTexts(updates)).toEqual(["61"]);
+  });
+
   it("dedupes streamed text even when the stream arrives before the user echo", async () => {
