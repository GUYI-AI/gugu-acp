From cd8404db75522b0c38a3aef543aa60af70baee77 Mon Sep 17 00:00:00 2001
From: Yang YiHe <108562510+nmhjklnm@users.noreply.github.com>
Date: Tue, 20 Oct 2026 19:26:55 +0800
Subject: [PATCH 06/14] Preserve streamed text on a repeated start of the same
 message

Why: Claude Code 2.1.304 with a gateway can emit another message_start for
an already-streamed API message before its consolidated assistant message.
Clearing the delivered prefix at that point repeats every answer in Gugu.
Reset only for a different or missing API message id, independently for
each parent stream. Retain the existing fallback for id-less gateways.

Upstream: none yet; reproduced in the source-level regression test from a
real SDK event sequence during Gugu issue #7582 acceptance.
Drop: when upstream preserves the delivered prefix across repeated starts
of the same API message and includes equivalent regression coverage.
---
 src/acp-agent.ts            | 22 ++++++++++++++++++++--
 src/tests/acp-agent.test.ts | 19 +++++++++++++++++++
 2 files changed, 39 insertions(+), 2 deletions(-)

diff --git a/src/acp-agent.ts b/src/acp-agent.ts
index 42387c6..3e2ff9b 100644
--- a/src/acp-agent.ts
+++ b/src/acp-agent.ts
@@ -4499,6 +4499,7 @@ export class ClaudeAcpAgent {
     // subagent message gets the same remainder diff as a top-level message.
     // The entry of a subagent goes when the subagent finishes.
     const streamedBlocksByParent = new Map<string, StreamedBlock[]>();
+    const streamMessageIdsByParent = new Map<string, string>();
     const streamedBlocksOf = (parentToolUseId: string | null): StreamedBlock[] => {
       const key = parentToolUseId ?? "";
       let blocks = streamedBlocksByParent.get(key);
@@ -6620,6 +6621,7 @@ export class ClaudeAcpAgent {
                   // The subagent streams no more text under this parent.
                   streamedBlocksByParent.delete(message.tool_use_id);
                   droppedStreams.delete(message.tool_use_id);
+                  streamMessageIdsByParent.delete(message.tool_use_id);
                 }
                 await endBackgroundTerminal(message.task_id);
                 if (message.status === "stopped") {
@@ -6665,6 +6667,7 @@ export class ClaudeAcpAgent {
                   if (parentToolUseId) {
                     streamedBlocksByParent.delete(parentToolUseId);
                     droppedStreams.delete(parentToolUseId);
+                    streamMessageIdsByParent.delete(parentToolUseId);
                   }
                   await endBackgroundTerminal(message.task_id);
                   if (message.patch.status === "killed") {
@@ -7690,8 +7693,23 @@ export class ClaudeAcpAgent {
               // doesn't disturb the mid-message turn-activation path the way
               // resetting on turn activation would. The record's drop latch
               // (see below) resets with it.
-              streamedBlocksOf(message.parent_tool_use_id).length = 0;
-              droppedStreams.delete(message.parent_tool_use_id ?? "");
+              // Some CLI/gateway pairs repeat message_start for the same API
+              // message between its live stream and its assembled assistant
+              // message. That is still the same content: retain the prefix
+              // already delivered. A different (or missing) id starts fresh.
+              const streamKey = message.parent_tool_use_id ?? "";
+              if (
+                !currentStreamMessageId ||
+                streamMessageIdsByParent.get(streamKey) !== currentStreamMessageId
+              ) {
+                streamedBlocksOf(message.parent_tool_use_id).length = 0;
+                droppedStreams.delete(streamKey);
+              }
+              if (currentStreamMessageId) {
+                streamMessageIdsByParent.set(streamKey, currentStreamMessageId);
+              } else {
+                streamMessageIdsByParent.delete(streamKey);
+              }
             }
             if (
               message.parent_tool_use_id === null &&
diff --git a/src/tests/acp-agent.test.ts b/src/tests/acp-agent.test.ts
index 16024dd..6dd34dd 100644
--- a/src/tests/acp-agent.test.ts
+++ b/src/tests/acp-agent.test.ts
@@ -15936,6 +15936,25 @@ describe("assembled assistant text fallback", () => {
     expect(messageChunkTexts(updates)).toEqual(["hello ", "world"]);
   });
 
+  it("keeps streamed text when the SDK repeats message_start before the assembled message", async () => {
+    const { agent, updates } = createMockAgentWithCapture();
+    // Claude Code 2.1.304 through a gateway: the complete live stream is
+    // followed by another start for the SAME API message, then its assembled
+    // assistant message. The second start must not erase the delivered prefix.
+    injectSession(agent, [
+      messageStart("resp-repeated-start"),
+      textDelta("61"),
+      messageStart("resp-repeated-start"),
+      assistantMessage("resp-repeated-start", [{ type: "text", text: "61" }]),
+      result(),
+      idle,
+    ]);
+
+    await agent.prompt({ sessionId: "test-session", prompt: [{ type: "text", text: "hi" }] });
+
+    expect(messageChunkTexts(updates)).toEqual(["61"]);
+  });
+
   it("dedupes streamed text even when the stream arrives before the user echo", async () => {
     const { agent, updates } = createMockAgentWithCapture();
     // Production ordering: the SDK emits the assistant's stream events before it
