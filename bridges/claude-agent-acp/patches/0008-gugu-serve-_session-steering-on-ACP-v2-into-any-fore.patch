+
+describe("ACP v2 extensions", () => {
+  /** The steering request of the ACP steering extension, with next delivery. */
+  const steer = (agent: v2.ClientContext, sessionId: string, message: string) =>
+    agent.request<{ outcome: string; reason?: string }>("_session/steering", {
+      sessionId,
+      prompt: text(message),
+      _meta: { steering: { delivery: "next" } },
+    });
+
+  /** Claude Code's echo of a message it takes in. */
+  const echo = (message: SDKUserMessage, options: Options) => ({
+    type: "user",
+    message: message.message,
+    parent_tool_use_id: null,
+    uuid: message.uuid,
+    session_id: options.sessionId,
+    isReplay: true,
+  });
+
+  it("steers a message into the running turn at the next tool boundary, and leaves it to the client when no work runs", async () => {
+    const steered: SDKUserMessage[] = [];
+    sdk.run = async function* (prompts, options) {
+      const input = prompts[Symbol.asyncIterator]();
+      const first = (await input.next()).value as SDKUserMessage;
+      yield echo(first, options);
+      const steer = (await input.next()).value as SDKUserMessage;
+      steered.push(steer);
+      yield echo(steer, options);
+      yield assistantText(options, "Both done.");
+      yield result(options);
+      yield idleState(options);
+      while (!(await input.next()).done);
+    };
+    const client = v2Client();
+    await client.app.connectWith(connectRouter(), async (agent) => {
+      await initializeV2(agent);
+      const { sessionId } = await agent.request(v2.methods.agent.session.new, { cwd });
+      await agent.request(v2.methods.agent.session.prompt, { sessionId, prompt: text("hi") });
+      await vi.waitFor(() => expect(turnTrace(client.sessionUpdates)).toContain("running"));
+
+      expect(await steer(agent, sessionId, "also this")).toEqual({ outcome: "injected" });
+      await vi.waitFor(() => expect(turnTrace(client.sessionUpdates)).toContain("idle end_turn"));
+      // No work runs: a v2 client sends the message as a prompt itself, also
+      // without asking for that in `_meta.steering.idleBehavior`.
+      expect(await steer(agent, sessionId, "later")).toEqual({
+        outcome: "promptRequired",
+        reason: "noRunningTurn",
+      });
+      await client.authUpdate(1);
+    });
+
+    expect(steered.map((message) => message.priority)).toEqual(["next"]);
+    // One piece of work: the steered message joined the turn.
+    expect(turnTrace(client.sessionUpdates)).toEqual([
+      "user_message",
+      "running",
+      "agent_message_chunk",
+      "idle end_turn",
+    ]);
+  });
+
+  it("steers a message into a cycle that Claude Code started on its own", async () => {
+    const steered: SDKUserMessage[] = [];
+    const cycleRunning = Promise.withResolvers<void>();
+    sdk.run = async function* (prompts, options) {
+      const input = prompts[Symbol.asyncIterator]();
+      const first = (await input.next()).value as SDKUserMessage;
+      yield echo(first, options);
+      yield assistantText(options, "Started the build in the background.");
+      yield result(options);
+      yield idleState(options);
+      // The build finishes, and Claude Code wakes the model to report it.
+      yield assistantText(options, "The build", "msg_followup");
+      cycleRunning.resolve();
+      const steer = (await input.next()).value as SDKUserMessage;
+      steered.push(steer);
+      yield echo(steer, options);
+      yield result(options, { origin: { kind: "task-notification" } });
+      yield idleState(options);
+      while (!(await input.next()).done);
+    };
+    const client = v2Client();
+    await client.app.connectWith(connectRouter(), async (agent) => {
+      await initializeV2(agent);
+      const { sessionId } = await agent.request(v2.methods.agent.session.new, { cwd });
+      await agent.request(v2.methods.agent.session.prompt, { sessionId, prompt: text("hi") });
+      await cycleRunning.promise;
+      await vi.waitFor(() =>
+        expect(turnTrace(client.sessionUpdates).filter((s) => s === "running")).toHaveLength(2),
+      );
+
+      expect(await steer(agent, sessionId, "and the tests?")).toEqual({ outcome: "injected" });
+      await vi.waitFor(() =>
+        expect(turnTrace(client.sessionUpdates).filter((s) => s.startsWith("idle"))).toHaveLength(
+          2,
+        ),
+      );
+      await client.authUpdate(1);
+    });
+
+    expect(steered.map((message) => message.priority)).toEqual(["next"]);
+    expect(turnTrace(client.sessionUpdates)).toEqual([
+      "user_message",
+      "running",
+      "agent_message_chunk",
+      "idle end_turn",
+      "running",
+      "agent_message_chunk",
+      "idle end_turn",
+    ]);
+  });
+});
