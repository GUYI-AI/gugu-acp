+/**
+ * Serves `_session/steering` as on v1. A v2 client has no legacy steering
+ * contract to keep, so a steer while no work runs always leaves the message to
+ * the client (`promptRequired`), which sends it as a prompt.
+ */
+function v2Steer(agent: ClaudeAcpAgent, params: SteerRequest): Promise<SteerResponse> {
+  return agent.steer({
+    ...params,
+    _meta: {
+      ...params._meta,
+      steering: { ...params._meta?.steering, idleBehavior: "promptRequired" },
+    },
+  });
