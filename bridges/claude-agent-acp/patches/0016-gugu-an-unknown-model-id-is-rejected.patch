From 88e8b77b058c87fbcebc3ef012712e2a490b9f75 Mon Sep 17 00:00:00 2001
From: shuxueshuxue <98064968+shuxueshuxue@users.noreply.github.com>
Date: Sat, 7 Nov 2026 18:02:38 -0500
Subject: [PATCH 16/16] gugu: an unknown model id is rejected, not matched to a
 row containing one of its letters

Why: resolveModelPreference's last tier scored a row by substring hits of any one token, so `claude-not-a-model-9` (tokens "not", "a", "model") matched "deepseek-v4-flash" on the letter "a"; set_config_option then switched to it and acknowledged success. The tier now requires every token to be a whole word of the row's value or display name. Bare ids against a "[1m]"-spelled row, family aliases (opus, opusplan, haiku) and display names resolve as before; an id nothing matches throws "Invalid value for config option model".

Upstream: none yet.

Drop when: upstream's token tier no longer accepts a partial or substring match.
---
 src/session-model.ts                     | 10 ++++--
 src/tests/model-resolution.test.ts       | 43 ++++++++++++++++++++++++
 src/tests/session-config-options.test.ts | 29 ++++++++++++++++
 3 files changed, 80 insertions(+), 2 deletions(-)

diff --git a/src/session-model.ts b/src/session-model.ts
index 5da5ecc..9020dc4 100644
--- a/src/session-model.ts
+++ b/src/session-model.ts
@@ -102,11 +102,17 @@ function tokenizeModelPreference(model: string): { tokens: string[]; contextHint
 }
 
 function scoreModelMatch(model: ModelInfo, tokens: string[], contextHint?: string): number {
-  const haystack = `${model.value} ${model.displayName}`.toLowerCase();
+  // Every token but a context size ("1m", from "[1m]" or "-1m") must be a whole
+  // word of the row: an unknown id must not land on whichever row happens to
+  // contain one of its letters.
+  const words = new Set(`${model.value} ${model.displayName}`.toLowerCase().split(/[^a-z0-9]+/));
   let score = 0;
   let nonHintMatched = false;
   for (const token of tokens) {
-    if (!haystack.includes(token)) continue;
+    if (!words.has(token)) {
+      if (/^\d+m$/.test(token)) continue;
+      return 0;
+    }
     if (token !== contextHint) nonHintMatched = true;
     score += token === contextHint ? 3 : 1;
   }
