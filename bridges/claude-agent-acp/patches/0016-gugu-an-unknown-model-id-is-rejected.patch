   },
 ];
 
+// A session whose picker lists gateway rows by full id, some only in the
+// "[1m]" spelling, next to unrelated non-Claude rows.
+const GATEWAY_SHAPED_MODELS: ModelInfo[] = [
+  { value: "gpt-6-luna", displayName: "GPT-6 Luna", description: "" },
+  { value: "deepseek-v4-flash", displayName: "DeepSeek V4 Flash", description: "" },
+  { value: "claude-haiku-5-5[1m]", displayName: "Claude Haiku 5.5", description: "" },
+  { value: "claude-opus-5-5[1m]", displayName: "Claude Opus 5.5", description: "" },
+];
+
+describe("resolveModelPreference - token matching", () => {
+  it("lands a bare id on the row the picker lists in its '[1m]' spelling", () => {
+    expect(resolveModelPreference(GATEWAY_SHAPED_MODELS, "claude-haiku-5-5")?.value).toBe(
+      "claude-haiku-5-5[1m]",
+    );
+    expect(resolveModelPreference(GATEWAY_SHAPED_MODELS, "claude-opus-5-5-1m")?.value).toBe(
+      "claude-opus-5-5[1m]",
+    );
+  });
+
+  it("still resolves family aliases and display names", () => {
+    expect(resolveModelPreference(GATEWAY_SHAPED_MODELS, "haiku")?.value).toBe(
+      "claude-haiku-5-5[1m]",
+    );
+    expect(resolveModelPreference(GATEWAY_SHAPED_MODELS, "Claude Opus 5.5")?.value).toBe(
+      "claude-opus-5-5[1m]",
+    );
+    expect(resolveModelPreference(LIVE_SHAPED_MODELS, "opus")?.value).toBe("opus[1m]");
+    expect(resolveModelPreference(LIVE_SHAPED_MODELS, "opusplan")?.value).toBe("opus[1m]");
+    expect(resolveModelPreference(LIVE_SHAPED_MODELS, "Sonnet")?.value).toBe("sonnet");
+  });
+
+  it("keeps a hinted id on its bare row when no hinted sibling is listed", () => {
+    expect(resolveModelPreference(LIVE_SHAPED_MODELS, "claude-sonnet-5[1m]")?.value).toBe("sonnet");
+    expect(resolveModelPreference(LIVE_SHAPED_MODELS, "claude-sonnet-5-1m")?.value).toBe("sonnet");
+    expect(resolveModelPreference(LIVE_SHAPED_MODELS, "claude-haiku-4-5-1m")?.value).toBe("haiku");
+  });
+
+  it("does not land an unknown id on a row that merely contains one of its letters", () => {
+    expect(resolveModelPreference(GATEWAY_SHAPED_MODELS, "claude-not-a-model-9")).toBeNull();
+    expect(resolveModelPreference(LIVE_SHAPED_MODELS, "claude-not-a-model-9")).toBeNull();
+  });
+});
+
 describe("resolveModelPreference - resolvedModel matching", () => {
   it("matches a preference that equals an alias's resolvedModel exactly", () => {
     expect(resolveModelPreference(LIVE_SHAPED_MODELS, "claude-sonnet-5")?.value).toBe("sonnet");
