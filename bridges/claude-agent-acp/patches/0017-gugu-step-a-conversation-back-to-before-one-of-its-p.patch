+
+describe("gugu conversation revert (_session/revert)", () => {
+  it("gives every prompt but the first its revert point, to a client that declares gugu.revert", async () => {
+    const turn: TurnScript = async function* (options) {
+      yield assistantText(options, "Hello!");
+      yield result(options);
+    };
+    const echoed = scriptTurns(turn, turn);
+    const client = v2Client();
+    await client.app.connectWith(connectRouter(), async (agent) => {
+      await initializeV2(agent, { _meta: { "gugu.revert": true } } as v2.ClientCapabilities);
+      const { sessionId } = await agent.request(v2.methods.agent.session.new, { cwd });
+      // Nothing is kept before the first prompt of a conversation, so there is no point to step back to.
+      const first = await agent.request(v2.methods.agent.session.prompt, { sessionId, prompt: text("hi") });
+      expect(first).toEqual({ messageId: echoed[0] });
+      await vi.waitFor(() => expect(turnTrace(client.sessionUpdates).at(-1)).toBe("idle end_turn"));
+      const second = await agent.request(v2.methods.agent.session.prompt, { sessionId, prompt: text("again") });
+      expect(second).toEqual({ messageId: echoed[1], _meta: { guguRevert: { before: echoed[1], files: true } } });
+      await vi.waitFor(() => expect(turnTrace(client.sessionUpdates).filter((state) => state === "idle end_turn")).toHaveLength(2));
+      await client.authUpdate(1);
+    });
+  });
+
+  it("gives no revert point to a client that does not declare gugu.revert", async () => {
+    const turn: TurnScript = async function* (options) {
+      yield assistantText(options, "Hello!");
+      yield result(options);
+    };
+    const echoed = scriptTurns(turn, turn);
+    const client = v2Client();
+    await client.app.connectWith(connectRouter(), async (agent) => {
+      await initializeV2(agent);
+      const { sessionId } = await agent.request(v2.methods.agent.session.new, { cwd });
+      await agent.request(v2.methods.agent.session.prompt, { sessionId, prompt: text("hi") });
+      await vi.waitFor(() => expect(turnTrace(client.sessionUpdates).at(-1)).toBe("idle end_turn"));
+      const second = await agent.request(v2.methods.agent.session.prompt, { sessionId, prompt: text("again") });
+      expect(second).toEqual({ messageId: echoed[1] });
+      await vi.waitFor(() => expect(turnTrace(client.sessionUpdates).filter((state) => state === "idle end_turn")).toHaveLength(2));
+      await client.authUpdate(1);
+    });
+  });
+
+  it("refuses a malformed revert target", async () => {
+    const { parseRevertRequest } = await import("../acp-agent.js");
+    expect(parseRevertRequest({ sessionId: "s", before: "u" })).toEqual({ sessionId: "s", before: "u" });
+    expect(parseRevertRequest({ sessionId: "s", before: "u", restoreFiles: false })).toEqual({ sessionId: "s", before: "u" });
+    expect(parseRevertRequest({ sessionId: "s", before: "u", restoreFiles: true })).toEqual({ sessionId: "s", before: "u", restoreFiles: true });
+    expect(() => parseRevertRequest({ sessionId: "s", before: "" })).toThrow("Invalid conversation revert target");
+    expect(() => parseRevertRequest({ sessionId: "s", before: "u", restoreFiles: "yes" })).toThrow("Invalid conversation revert target");
+  });
+
+  it("knows the entry a revert writes, as a string and as a single text block, and nothing else", async () => {
+    const { REVERT_MARK, isRevertMark } = await import("../acp-agent.js");
+    expect(isRevertMark({ type: "user", message: { role: "user", content: REVERT_MARK } })).toBe(true);
+    expect(isRevertMark({ type: "user", message: { role: "user", content: [{ type: "text", text: REVERT_MARK }] } })).toBe(true);
+    expect(isRevertMark({ type: "user", message: { role: "user", content: `${REVERT_MARK} and more` } })).toBe(false);
+    expect(isRevertMark({ type: "assistant", message: { role: "assistant", content: REVERT_MARK } })).toBe(false);
+  });
+});
