index 5a32b9d..745b9ab 100644
--- a/src/acp-agent.ts
+++ b/src/acp-agent.ts
@@ -703,6 +703,19 @@ const TURN_NO_RESULT_MESSAGE =
  *  `InitializeResponse._meta.steering.supported`. */
 export const STEER_METHOD = "_session/steering";
 
+/** gugu (#7304): step a conversation back to before one of its prompts. See `ClaudeAcpAgent.revertConversation`. */
+export const REVERT_METHOD = "_session/revert";
+export type RevertRequest = { sessionId: string; before: string; files?: "keep" | "restore" };
+export type RevertResponse = { sessionId: string; files: "kept" | "restored" };
+export function parseRevertRequest(params: unknown): RevertRequest {
+  const value = (params ?? {}) as Partial<RevertRequest>;
+  if (typeof value.sessionId !== "string" || typeof value.before !== "string" || !value.before
+    || (value.files !== undefined && value.files !== "keep" && value.files !== "restore")) {
+    throw RequestError.invalidParams(params, "Invalid conversation revert target");
+  }
+  return { sessionId: value.sessionId, before: value.before, ...(value.files ? { files: value.files } : {}) };
+}
+
 /** Stops one Claude background task without cancelling the parent prompt turn. */
 export const ASYNC_TASK_STOP_METHOD = "_session/async_task/stop";
 
@@ -3239,6 +3252,62 @@ export class ClaudeAcpAgent {
    * copied transcript, with the model and the permission mode it records. A
    * later load or resume with the same settings reuses it.
    */
+  /**
+   * gugu (#7304): steps the conversation back to before one of its prompts, in place: the same session id, a query
+   * resumed at the last chain entry before that prompt (`resumeSessionAt`), so the next prompt continues from there.
+   * `before` is the prompt uuid that the prompt's receipt and a replay give as the revert point. With
+   * `files: "restore"`, the files Claude edited from that prompt on are restored first (`Query.rewindFiles`; Bash
+   * changes are not tracked). The rewound entries stay in the transcript file as a branch that nothing reads; a plain
+   * resume before the next prompt can still bring them back, as in Claude Code's own `/rewind`.
+   */
+  /** gugu (#7304): the client declared `_meta["gugu.revert"]`, so prompts carry the point a revert steps back to. */
+  revertAnchors(): boolean {
+    const meta = (this.clientCapabilities as { _meta?: Record<string, unknown> } | undefined)?._meta;
+    return meta?.["gugu.revert"] === true;
+  }
+
+  /** gugu (#7304): whether a revert can also restore files: checkpointing is on for file reports and for revert. */
+  revertRestoresFiles(): boolean {
+    return this.revertAnchors() || supportsAgentFileChangeReport(this.clientCapabilities);
+  }
+
+  async revertConversation(params: RevertRequest): Promise<RevertResponse> {
+    while (this.providerUpdate) await this.providerUpdate;
+    const session = this.sessions[params.sessionId];
+    if (!session?.creationParams) {
+      throw RequestError.invalidParams({ sessionId: params.sessionId }, "Unknown session");
+    }
+    if (session.turnQueue?.some((turn) => !turn.settled)) {
+      throw RequestError.invalidRequest(undefined, "Wait for current work to finish before reverting");
+    }
+    const messages = await getSessionMessages(params.sessionId);
+    const index = messages.findIndex((message) => message.uuid === params.before);
+    if (index < 0) {
+      throw RequestError.invalidParams({ before: params.before }, "This revert point is not in the conversation");
+    }
+    const kept = messages[index - 1]?.uuid;
+    if (!kept) {
+      throw RequestError.invalidParams(
+        { before: params.before },
+        "Claude Code cannot step back before the first message of a conversation",
+      );
+    }
+    let files: RevertResponse["files"] = "kept";
+    if (params.files === "restore") {
+      const result = await session.query.rewindFiles(params.before);
+      if (!result.canRewind) {
+        throw RequestError.internalError(result, `Could not restore the files: ${result.error ?? "no checkpoint"}`);
+      }
+      files = "restored";
+    }
+    await this.replaceSessionQuery(params.sessionId, session, session.creationParams, kept);
+    const recreated = this.sessions[params.sessionId];
+    if (!recreated || recreated.tornDown) {
+      throw RequestError.internalError(undefined, "The session closed while it was being reverted");
+    }
+    return { sessionId: params.sessionId, files };
+  }
+
   async unstable_forkSession(params: ForkSessionRequest): Promise<ForkSessionResponse> {
     while (this.providerUpdate) await this.providerUpdate;
     // Reject a bad `cwd` or prompt before copying the transcript.
