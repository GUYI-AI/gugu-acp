diff --git a/src/acp-agent.ts b/src/acp-agent.ts
index 5a32b9d..42b2368 100644
--- a/src/acp-agent.ts
+++ b/src/acp-agent.ts
@@ -703,9 +703,41 @@ const TURN_NO_RESULT_MESSAGE =
  *  `InitializeResponse._meta.steering.supported`. */
 export const STEER_METHOD = "_session/steering";
 
+/** gugu: step a conversation back to before one of its prompts. See `ClaudeAcpAgent.revertConversation`. */
+export const REVERT_METHOD = "_session/revert";
+/** `restoreFiles` also restores the files Claude edited from that prompt on; a restore that cannot be done fails the request. */
+export type RevertRequest = { sessionId: string; before: string; restoreFiles?: boolean };
+export type RevertResponse = { sessionId: string };
+export function parseRevertRequest(params: unknown): RevertRequest {
+  const value = (params ?? {}) as Partial<RevertRequest>;
+  if (typeof value.sessionId !== "string" || typeof value.before !== "string" || !value.before
+    || (value.restoreFiles !== undefined && typeof value.restoreFiles !== "boolean")) {
+    throw RequestError.invalidParams(params, "Invalid conversation revert target");
+  }
+  return { sessionId: value.sessionId, before: value.before, ...(value.restoreFiles ? { restoreFiles: true } : {}) };
+}
+
+/**
+ * gugu: the transcript entry a revert writes at the point it stepped back to (see `ClaudeAcpAgent.revertConversation`).
+ * The model reads it as part of the next prompt; a replay leaves it out.
+ */
+export const REVERT_MARK = "(The conversation was stepped back to this point. The turns after it were removed.)";
+export function isRevertMark(message: unknown): boolean {
+  const { type, message: api } = (message ?? {}) as { type?: unknown; message?: { content?: unknown } };
+  if (type !== "user") return false;
+  const content = api?.content;
+  if (content === REVERT_MARK) return true;
+  return Array.isArray(content) && content.length === 1
+    && (content[0] as { type?: unknown; text?: unknown })?.type === "text"
+    && (content[0] as { text?: unknown }).text === REVERT_MARK;
+}
+
 /** Stops one Claude background task without cancelling the parent prompt turn. */
 export const ASYNC_TASK_STOP_METHOD = "_session/async_task/stop";
 
+/** How long a revert waits for Claude Code to write its entry before it fails. */
+const REVERT_PERSIST_TIMEOUT_MS = 15_000;
+
 export type AsyncTaskStopRequest = {
   sessionId: string;
   asyncTaskId: string;
@@ -1185,6 +1217,8 @@ export type Session = {
