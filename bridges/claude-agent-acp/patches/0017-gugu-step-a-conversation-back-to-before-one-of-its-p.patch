   remoteControlCommand?: Promise<void>;
@@ -3239,6 +3273,100 @@ export class ClaudeAcpAgent {
    * copied transcript, with the model and the permission mode it records. A
    * later load or resume with the same settings reuses it.
    */
+  /** gugu: the client declared `_meta["gugu.revert"]`: prompts carry the point a revert steps back to, and file checkpointing is on for it. */
+  revertAnchors(): boolean {
+    const meta = (this.clientCapabilities as { _meta?: Record<string, unknown> } | undefined)?._meta;
+    return meta?.["gugu.revert"] === true;
+  }
+
+  /**
+   * gugu: the revert point of the prompt Claude Code just took in, as `_meta.guguRevert` of its receipt; a replay
+   * gives the same shape. `files` = a revert to it can also restore files. The first prompt of a conversation has
+   * none: there is no earlier entry to continue from (see `revertConversation`).
+   */
+  revertPoint(sessionId: string, promptUuid: string): { before: string; files: true } | undefined {
+    const session = this.sessions[sessionId];
+    if (!session || !this.revertAnchors()) return undefined;
+    const first = !session.resumedFromHistory && !session.promptTaken;
+    session.promptTaken = true;
+    return first ? undefined : { before: promptUuid, files: true };
+  }
+
+  /**
+   * gugu: steps the conversation back to before one of its prompts, in place: the same session id, a query resumed
+   * at the last chain entry before that prompt (`resumeSessionAt`), so the next prompt continues from there.
+   * `before` is the prompt uuid that the prompt's receipt and a replay give as the revert point. With `restoreFiles`,
+   * the files Claude edited from that prompt on are restored first (`Query.rewindFiles`; Bash changes are not tracked).
+   *
+   * `resumeSessionAt` alone writes nothing: the transcript still ends at the removed turns, and any plain resume
+   * before the next prompt (a restart of this adapter, `claude --resume` in a terminal) continues from them. So the
+   * revert appends one entry at the kept point (`REVERT_MARK`, `shouldQuery: false`: no model turn) and answers only
+   * once it is in the transcript. From then on the removed turns are a branch that nothing continues.
+   * `resumeDropsTurn` is not passed: its validator refuses a later revert that would remove such an entry.
+   */
+  async revertConversation(params: RevertRequest): Promise<RevertResponse> {
+    while (this.providerUpdate) await this.providerUpdate;
+    const session = this.sessions[params.sessionId];
+    if (!session?.creationParams) {
+      throw RequestError.invalidParams({ sessionId: params.sessionId }, "Unknown session");
+    }
+    if (session.turnQueue?.some((turn) => !turn.settled)) {
+      throw RequestError.invalidRequest(undefined, "Wait for current work to finish before reverting");
+    }
+    const messages = await getSessionMessages(params.sessionId);
+    const index = messages.findIndex((message) => message.uuid === params.before);
+    if (index < 0) {
+      throw RequestError.invalidParams({ before: params.before }, "This revert point is not in the conversation");
+    }
+    const kept = messages[index - 1]?.uuid;
+    if (!kept) {
+      throw RequestError.invalidParams(
+        { before: params.before },
+        "Claude Code cannot step back before the first message of a conversation",
+      );
+    }
+    if (params.restoreFiles) {
+      const result = await session.query.rewindFiles(params.before);
+      if (!result.canRewind) {
+        throw RequestError.internalError(result, `Could not restore the files: ${result.error ?? "no checkpoint"}`);
+      }
+    }
+    await this.replaceSessionQuery(params.sessionId, session, session.creationParams, kept);
+    const recreated = this.sessions[params.sessionId];
+    if (!recreated || recreated.tornDown) {
+      throw RequestError.internalError(undefined, "The session closed while it was being reverted");
+    }
+    await this.persistRevert(params.sessionId, recreated);
+    return { sessionId: params.sessionId };
+  }
+
+  /** Writes the revert into the transcript (see `revertConversation`) and waits until a plain resume would read it. */
+  private async persistRevert(sessionId: string, session: Session): Promise<void> {
+    const uuid = randomUUID();
+    (session.sentUserUuids ??= new Set()).add(uuid);
+    session.input.push({
+      type: "user",
+      message: { role: "user", content: REVERT_MARK },
+      parent_tool_use_id: null,
+      session_id: sessionId,
+      uuid,
+      shouldQuery: false,
+    } as SDKUserMessage);
+    this.ensureConsumer(session, sessionId);
+    const deadline = Date.now() + REVERT_PERSIST_TIMEOUT_MS;
+    for (;;) {
+      if ((await getSessionMessages(sessionId)).some((message) => message.uuid === uuid)) return;
+      if (session.tornDown) throw RequestError.internalError(undefined, "The session closed while it was being reverted");
+      if (Date.now() > deadline) {
+        throw RequestError.internalError(
+          undefined,
+          "The conversation was stepped back, but Claude Code did not record it; a restart before the next prompt brings the removed turns back",
+        );
+      }
+      await new Promise((resolve) => setTimeout(resolve, 100));
+    }
+  }
+
   async unstable_forkSession(params: ForkSessionRequest): Promise<ForkSessionResponse> {
     while (this.providerUpdate) await this.providerUpdate;
     // Reject a bad `cwd` or prompt before copying the transcript.
