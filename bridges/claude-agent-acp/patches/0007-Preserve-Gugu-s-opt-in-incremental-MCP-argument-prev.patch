+++ b/src/acp-agent.ts
@@ -1,3 +1,4 @@
+import { partialMcpInput } from "./partial-mcp-input.js";
 import {
   agent as acpAgent,
   AgentApp,
@@ -13798,11 +13799,12 @@ export function streamEventToAcpNotifications(
           if (inputsForMessage?.size === 0) streamedToolInputs?.delete(streamKey);
           return [];
         }
-        if (streamedInput.lastTopLevelComma <= streamedInput.emittedThroughComma) {
+        const stringInput = partialMcpInput(streamedInput.name, streamedInput.partialJson, streamedInput.inString);
+        if (!stringInput && streamedInput.lastTopLevelComma <= streamedInput.emittedThroughComma) {
           return [];
         }
         streamedInput.emittedThroughComma = streamedInput.lastTopLevelComma;
-        const input = recoveredToolInput(
+        const input = stringInput ?? recoveredToolInput(
           streamedInput.partialJson.slice(0, streamedInput.lastTopLevelComma),
         );
         if (!input) return [];
diff --git a/src/partial-mcp-input.ts b/src/partial-mcp-input.ts
new file mode 100644
index 0000000..995ec89
--- /dev/null
+++ b/src/partial-mcp-input.ts
@@ -0,0 +1,16 @@
+/** Recover an in-progress top-level MCP string without inventing its remaining text.
+ * Other tools retain their field-boundary rendering (large Write inputs in particular).
+ * JSON.parse remains the validator; incomplete keys, nested objects and invalid escapes
+ * produce no preview. A split escape waits until the next provider fragment.
+ */
+export function partialMcpInput(name: string, json: string, inString: boolean): Record<string, unknown> | undefined {
+  if (!name.startsWith("mcp__")) return undefined;
+  const candidates = inString ? [json + '\"}', ...(json.endsWith('\\') ? [json.slice(0, -1) + '\"}'] : [])] : [json + "}"];
+  for (const candidate of candidates) {
+    try {
+      const value = JSON.parse(candidate);
+      if (value && typeof value === "object" && !Array.isArray(value)) return value;
+    } catch { /* A partial escape/key is not a complete value. */ }
+  }
+  return undefined;
+}
diff --git a/src/tests/partial-mcp-input.test.ts b/src/tests/partial-mcp-input.test.ts
new file mode 100644
index 0000000..0078a9d
--- /dev/null
+++ b/src/tests/partial-mcp-input.test.ts
@@ -0,0 +1,23 @@
+import { describe, expect, it } from 'vitest'
+import { partialMcpInput } from '../partial-mcp-input.js'
+import { ClientCapabilities } from '../tool-calls/client-capabilities.js'
+
+/** Preserve the MCP preview behavior shipped by Gugu #7536. */
+describe('the shipped ACP bridge previews MCP arguments (#7536)', () => {
+  it('publishes actual growing text and waits for split escapes without guessing', () => {
+    const call = 'mcp__gugu__message_send'
+    expect(partialMcpInput(call, '{"chat_id":"chat","text":"你', true)).toEqual({ chat_id: 'chat', text: '你' })
+    expect(partialMcpInput(call, '{"chat_id":"chat","text":"你好', true)).toEqual({ chat_id: 'chat', text: '你好' })
+    expect(partialMcpInput(call, '{"text":"line\\', true)).toEqual({ text: 'line' })
+    expect(partialMcpInput(call, '{"text":"line\\n', true)).toEqual({ text: 'line\n' })
+    expect(partialMcpInput(call, '{"text":"\\u4f', true)).toBeUndefined()
+    expect(partialMcpInput(call, '{"nested":{"text":"unfinished', true)).toBeUndefined()
+    expect(partialMcpInput('Write', '{"content":"unfinished', true)).toBeUndefined()
+  })
+  it('requires the AIR client to explicitly opt into incremental argument previews', () => {
+    const air = { _meta: { 'jetbrains': { air: {} } } }
+    expect(ClientCapabilities.from(air).air.client).toBe(true)
+    expect(ClientCapabilities.from(air).partialMcpInput).toBe(false)
+    expect(ClientCapabilities.from({ ...air, _meta: { ...air._meta, 'gugu.mcp-input-preview': true } }).partialMcpInput).toBe(true)
+  })
+})
