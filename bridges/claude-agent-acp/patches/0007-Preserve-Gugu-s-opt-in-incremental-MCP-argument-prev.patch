 src/partial-mcp-input.ts              | 16 ++++++++++++++++
 src/tests/partial-mcp-input.test.ts   | 23 +++++++++++++++++++++++
 src/tool-calls/client-capabilities.ts |  3 +++
 src/tool-calls/renderer.ts            |  6 +++---
 5 files changed, 49 insertions(+), 5 deletions(-)
 create mode 100644 src/partial-mcp-input.ts
 create mode 100644 src/tests/partial-mcp-input.test.ts

